include "input.kdl"
include "layout.kdl"
include "environment.kdl"
include "startup.kdl"
include "window-rules.kdl"
include "effects.kdl"
include "binds.kdl"

// ── Misc top-level ────────────────────────────────────────────────────
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Don't pop the keybind cheatsheet on every startup (Mod+Shift+/ still shows it).
hotkey-overlay {
    skip-at-startup
}

debug {
  // Lets a notification's action buttons focus the app that sent it. Written
  // for noctalia originally; swaync needs exactly the same thing, so this
  // stays after the cutover.
  honor-xdg-activation-with-invalid-serial
}
