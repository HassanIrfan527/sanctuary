include "input.kdl"
include "environment.kdl"
include "startup.kdl"
include "window-rules.kdl"

// Layout and shape: `layout.kdl` is a symlink to one of the hand-kept
// layout-{signal,ink,paper}.kdl, re-pointed by scripts/sanctuary/shell.sh when
// you pick a style (no script writes config text). It sits AFTER
// window-rules.kdl deliberately: window-rule blocks are additive and the last
// one wins, which is the only reason it can override the 2px corner radius set
// there. Reorder these two and the radius silently stops applying.
include "layout.kdl"
include "effects.kdl"
include "binds.kdl"

// ── Misc top-level ────────────────────────────────────────────────────
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Don't pop the keybind cheatsheet on every startup (Mod+Shift+/ still shows it).
hotkey-overlay {
    skip-at-startup
}

debug {
  // Lets a notification's action buttons focus the app that sent it. Written
  // for noctalia originally; swaync needs exactly the same thing, so this
  // stays after the cutover.
  honor-xdg-activation-with-invalid-serial
}
