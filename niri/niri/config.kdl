include "input.kdl"
include "environment.kdl"
include "startup.kdl"
include "window-rules.kdl"

// Layout, space and shape for the current MODE. Generated by
// scripts/sanctuary/mode.sh from templates/mode.kdl.in — never edit it directly.
// It sits AFTER window-rules.kdl deliberately: window-rule blocks are additive
// and the last one wins, which is the only reason a mode can override the 2px
// corner radius set there. Reorder these two and the radius silently stops
// applying.
include "mode.kdl"
include "effects.kdl"
include "binds.kdl"

// ── Misc top-level ────────────────────────────────────────────────────
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Don't pop the keybind cheatsheet on every startup (Mod+Shift+/ still shows it).
hotkey-overlay {
    skip-at-startup
}

debug {
  // Lets a notification's action buttons focus the app that sent it. Written
  // for noctalia originally; swaync needs exactly the same thing, so this
  // stays after the cutover.
  honor-xdg-activation-with-invalid-serial
}
