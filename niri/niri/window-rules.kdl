// ── Window rules ──────────────────────────────────────────────────────
// 2px, not 20 — the island language is square (DESIGN-BRIEF.md §2).
window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
  background-effect {
    blur true
    xray false
  }
}

window-rule {
    match app-id="org.gnome.Calculator"
    match app-id="org.gnome.Calendar"
    match app-id="org.gnome.Weather"
    match app-id="pavucontrol"
    match app-id="nm-connection-editor"
    open-floating true
}

window-rule {
    match app-id="keysound-launcher"
    open-floating true
    default-column-width { fixed 700; }
    default-window-height { fixed 700; }
}

window-rule {
    match title="Brave"

    open-maximized true
}

// Picture-in-Picture floats.
window-rule {
    match title="Picture-in-Picture"
    open-floating true
}

// File dialogs float.
window-rule {
    match title="^(Open File|Save As|Open Folder)"
    open-floating true
}


// NOTE: do NOT add `place-within-backdrop true` for the wallpaper daemon.
// It moves the background surface into niri's overview backdrop, which means
// it stops being drawn on the normal workspace view — i.e. no wallpaper at all
// until you open the overview. Cost me a "the wallpaper is not applying" bug
// while `awww query` cheerfully reported it was displaying the image.

// ── The Sanctuary's floating terminals ────────────────────────────────
// Every "panel" in this desktop is a real kitty window with a class, so niri
// animates it like anything else and it inherits the kitty theme. That IS the
// panel system (DESKTOP-PLAN.md §3).
window-rule {
    match app-id="sanctuary-mixer"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 620; }
}

window-rule {
    match app-id="sanctuary-wallpaper"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 760; }
}

window-rule {
    match app-id="sanctuary-clipboard"
    open-floating true
    default-column-width { fixed 820; }
    default-window-height { fixed 520; }
}

window-rule {
    match app-id="sanctuary-music"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}
