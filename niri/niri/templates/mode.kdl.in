// ── Layout + shape · mode: @NAME@ ─────────────────────────────────────
// GENERATED by scripts/sanctuary/mode.sh from niri/templates/mode.kdl.in.
// Do NOT edit this file — every mode switch overwrites it. Change the structure
// in the template; change the numbers in scripts/sanctuary/modes/<name>.conf.
//
// Why a rendered file and not a small "zen override" include: niri permits
// exactly ONE top-level layout block. A second one fails validation with
// "duplicate node layout, single node expected" — so a mode cannot add gaps on
// top of the base layout, it has to BE the layout block.

layout {
    gaps @GAPS@                     // inner gap BETWEEN windows (= Hyprland gaps_in)
    struts {
        left @STRUT_SIDE@
        right @STRUT_SIDE@
        top @STRUT_TOP@
        bottom @STRUT_BOTTOM@
    }
    center-focused-column "never"   // columns stay put; never auto-recenter
    @CENTER_SINGLE@
    // Widths cycled by Mod+R. This IS niri's "resize" idiom.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion @DEFAULT_WIDTH@; }

    border {
        on
        width @BORDER@
        active-color "#b4befe"      // focused —  mocha lavender accent
        inactive-color "#6c7086"    // unfocused —  $inactive
    }
    focus-ring { off; }
}

// ── Overview ──────────────────────────────────────────────────────────
overview {
    // zoom 0.5            // 1.0 = no zoom, smaller = further out (default ~0.5)
    backdrop-color "#1e1e2e"
}

// ── Shape ─────────────────────────────────────────────────────────────
// The opposite case to `layout`: `window-rule` blocks ARE additive and the LAST
// one wins, so this overrides the 2px floor in `window-rules.kdl`. That only
// holds because `config.kdl` includes this file *after* it — if you reorder the
// includes, the radius silently stops applying.
window-rule {
    geometry-corner-radius @RADIUS@
    clip-to-geometry true

    // niri's opacity is the WHOLE window, text included — unlike kitty's
    // background_opacity, which keeps glyphs solid. So this stays close to 1:
    // it is here to let the blur in effects.kdl register behind a window, not to
    // make anything see-through. Push it below ~0.92 and text starts to wash out.
    opacity @WINDOW_OPACITY@
}
