// ── Environment ───────────────────────────────────────────────────────
// NOTE: XDG_CURRENT_DESKTOP is intentionally NOT set here — niri sets it to
// "niri" itself. (Your Hyprland env.conf forced it to "Hyprland"; that must
// not carry over.) Cursor is handled by the cursor{} block in input.kdl.
environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    GDK_BACKEND "wayland,x11,*"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XCURSOR_THEME "Drop-Purple"
    XCURSOR_SIZE "24"
}
