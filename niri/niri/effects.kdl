blur {
    passes 2        // downsample/upsample iterations — more = larger, smoother, costs GPU
    offset 3.0        // per-pass pixel spread; >1 smooths further at NO extra GPU cost
    noise 0.03      // tiny grain to kill colour banding from the blur
    saturation 1.3   // 1 = normal; raise for punchier colours behind glass
    on
}

// The bar, the launcher and the notification centre are deliberately NOT
// blurred. They are islands with a solid fill — visible structure is the
// craft, and transparency was tried and rejected twice (DESIGN-BRIEF.md §3).
