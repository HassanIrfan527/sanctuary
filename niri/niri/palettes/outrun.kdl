// Outrun '84 — generated by scripts/sanctuary/palette.py build from palettes/signal.json — edit that, not this
// Merged over layout-signal.kdl: only the colours (and, with effects, the glow); the shape stays.
layout {
    border {
        active-gradient from="#f92aad" to="#36f9f6" angle=135
        inactive-color "#34294a"
    }
    shadow {
        on
        softness 40
        spread 6
        offset x=0 y=0
        draw-behind-window true
        color "#f92aadbf"
        inactive-color "#00000000"
    }
}
overview {
    backdrop-color "#241b2f"
}
