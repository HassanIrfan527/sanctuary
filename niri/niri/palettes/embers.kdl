// Night City Embers — generated by scripts/sanctuary/palette.py build from palettes/signal.json — edit that, not this
// Merged over layout-signal.kdl: only the colours (and, with effects, the glow); the shape stays.
layout {
    border {
        active-gradient from="#e8264a" to="#c2409a" angle=135
        inactive-color "#2a1d33"
    }
    shadow {
        on
        softness 33
        spread 4
        offset x=0 y=0
        draw-behind-window true
        color "#e8264aa1"
        inactive-color "#00000000"
    }
}
overview {
    backdrop-color "#18101d"
}
