// Tokyo Night — generated by scripts/sanctuary/palette.py build from palettes/signal.json — edit that, not this
// Merged over layout-signal.kdl: only the colours (and, with effects, the glow); the shape stays.
layout {
    border {
        active-gradient from="#7aa2f7" to="#bb9af7" angle=135
        inactive-color "#292e42"
    }
    shadow {
        on
        softness 27
        spread 3
        offset x=0 y=0
        draw-behind-window true
        color "#7aa2f787"
        inactive-color "#00000000"
    }
}
overview {
    backdrop-color "#1a1b26"
}
