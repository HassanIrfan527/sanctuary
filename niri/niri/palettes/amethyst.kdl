// Amethyst — generated by scripts/sanctuary/palette.py build from palettes/signal.json — edit that, not this
// Merged over layout-signal.kdl: only the colours (and, with effects, the glow); the shape stays.
layout {
    border {
        active-gradient from="#a35cf5" to="#e070e8" angle=135
        inactive-color "#241843"
    }
    shadow {
        on
        softness 40
        spread 6
        offset x=0 y=0
        draw-behind-window true
        color "#a35cf5bf"
        inactive-color "#00000000"
    }
}
overview {
    backdrop-color "#140d22"
}
