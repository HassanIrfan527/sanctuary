// Section 9 — generated by scripts/sanctuary/palette.py build from palettes/signal.json — edit that, not this
// Merged over layout-signal.kdl: only the colours (and, with effects, the glow); the shape stays.
layout {
    border {
        active-gradient from="#e0303f" to="#a46bff" angle=135
        inactive-color "#252042"
    }
    shadow {
        on
        softness 29
        spread 4
        offset x=0 y=0
        draw-behind-window true
        color "#e0303f91"
        inactive-color "#00000000"
    }
}
overview {
    backdrop-color "#16132c"
}
