// ── Input / pointer / output ──────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 250
        repeat-rate 35
    }


    mouse {}

    // Hover-to-focus (like Hyprland). max-scroll-amount="0%" is the key part:
    // it lets the pointer focus the window under it, but NEVER scrolls the view
    // to do so — that scroll was the "graze a screen edge and the columns leap"
    // annoyance from before. Focus only changes for windows already on screen.
    focus-follows-mouse max-scroll-amount="0%"
}

// Disable the top-left hot corner that opens the overview on pointer drag.
gestures {
    hot-corners {
        off
    }
}

output "eDP-1" {
    scale 1.0
    // mode "1920x1080@60.000"
}

cursor {
    hide-after-inactive-ms 5000
}
