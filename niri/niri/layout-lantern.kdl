// ── Layout + shape · LANTERN ────────────────────────────────────────────
// Hand-maintained. Edit this file directly — nothing generates it.
//
// One of the hand-kept layout files: layout-<style>.kdl (signal, flare,
// lantern, harvest).
// config.kdl includes `layout.kdl`, a symlink to the active
// one. Picking a style (Mod+Shift+T → shell.sh set) only re-points that
// symlink and reloads niri — no script ever writes config text (the
// 2026-10-03 rule; the old per-mode renderer is in archive/mode-system/).
//
// Lantern: the pixel style (night, 2026-10-16; docs/styles/lantern-harvest.md).
// Signal's geometry, with three differences: the focused window wears a 4px
// pink frame (pink is YOU), the cursor is the pixel one (Lantern-Pixel /
// Harvest-Pixel, built by scripts/sanctuary/pixel-cursors.py), and windows
// don't animate — the pixel style has no motion (Harry, 2026-10-16).
//
// niri permits exactly ONE top-level layout block ("duplicate node layout"), so
// each layout file holds the whole layout.

layout {
    gaps 6                          // inner gap BETWEEN windows
    struts {
        left 8
        right 8
        top 4                       // the bar's own exclusive zone sits on top of this
        bottom 8
    }
    center-focused-column "never"   // columns stay put; never auto-recenter
    // Widths cycled by Mod+R. This IS niri's "resize" idiom.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    border {
        on
        width 4                     // two art pixels, like the bar's frames
        active-color "#ff5c9d"      // focused — pink, it's you
        inactive-color "#2c2650"    // unfocused — raised paper
    }
    focus-ring { off; }
}

// ── Overview ──────────────────────────────────────────────────────────
overview {
    backdrop-color "#0f0c1e"     // the night's sunk ink
}

// ── Shape ─────────────────────────────────────────────────────────────
// `window-rule` blocks are additive and the LAST one wins, so this overrides the
// 2px floor in window-rules.kdl. That only holds because config.kdl includes
// this file *after* it — reorder the includes and the radius silently stops
// applying.
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// ── Cursor ────────────────────────────────────────────────────────────
// Merged with input.kdl's cursor block (which keeps hide-after-inactive-ms).
// Signal's layouts have none, so they fall back to the default (Bibata).
cursor {
    xcursor-theme "Lantern-Pixel"
    xcursor-size 24
}

// ── Motion: none ──────────────────────────────────────────────────────
animations {
    off
}
