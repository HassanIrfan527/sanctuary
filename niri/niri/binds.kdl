// ── Keybinds ──────────────────────────────────────────────────────────
binds {
    //── Launch apps ──
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+E      { spawn "sh" "-c" "kitty -e superfile"; }
    Mod+Y      { spawn "nautilus"; }
    Mod+B      { spawn "brave"; }

    //── Launcher ──
    Mod+Space hotkey-overlay-title="Launcher" {
        spawn-sh "fuzzel --config=$HOME/.dotfiles/fuzzel/fuzzel/fuzzel.ini";
    }

    //── Notifications (swaync) ──
    Mod+Shift+D hotkey-overlay-title="Notification centre" { spawn "swaync-client" "-t"; }
    Mod+Ctrl+D  { spawn "swaync-client" "-C"; }   // close all
    Mod+Alt+D   { spawn "swaync-client" "-d"; }   // do-not-disturb toggle

    //── Panels that are really terminals ──
    // The panel-free answer to every GUI popup: a TUI in a floating kitty with
    // a class niri has a window-rule for. See DESKTOP-PLAN.md §3.
    Mod+V hotkey-overlay-title="Clipboard" {
        spawn "kitty" "--class" "sanctuary-clipboard" "-e" "/home/dweller/.dotfiles/scripts/sanctuary/clipboard.sh";
    }
    Mod+Alt+M hotkey-overlay-title="Audio mixer" {
        spawn "kitty" "--class" "sanctuary-mixer" "-e" "wiremix";
    }
    Mod+Shift+W hotkey-overlay-title="Wallpaper" {
        spawn "/home/dweller/.dotfiles/scripts/sanctuary/wallpaper.sh" "pick";
    }
    Mod+Shift+A { spawn "/home/dweller/.dotfiles/scripts/sanctuary/bar.sh" "toggle"; }

    //── Audio ──  wpctl talks to pipewire directly; the bar is the readout.
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.0"; }
    Mod+Equal            { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.0"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    Mod+Minus            { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    Mod+0                { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // Mic is a readout on the bar and a keybind here — never a button.
    Mod+M         { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // No brightness binds: this machine has no /sys/class/backlight device.

    //── Night light ──  manual, always on. Warmer = more filter.
    //   Clamped to 1500-6500K; 6500 is neutral daylight, i.e. off.
    Mod+Ctrl+Minus hotkey-overlay-title="Night light warmer" {
        spawn "/home/dweller/.dotfiles/scripts/sanctuary/nightlight.sh" "warmer";
    }
    Mod+Ctrl+Equal hotkey-overlay-title="Night light cooler" {
        spawn "/home/dweller/.dotfiles/scripts/sanctuary/nightlight.sh" "cooler";
    }
    Mod+Ctrl+0 { spawn "/home/dweller/.dotfiles/scripts/sanctuary/nightlight.sh" "reset"; }

    //── Overview ──  zoomed-out view of all workspaces/columns; drag windows around
    Mod+Tab { toggle-overview; }

    //── Window management ──
    Mod+W       { close-window; }
    Mod+F       { maximize-column; }        // HL fullscreen 1
    Mod+Shift+F { fullscreen-window; }      // HL fullscreen 0
    Mod+Shift+V { toggle-window-floating; }
    Mod+Alt+C   { center-column; }

    //── Focus (vim) ──  H/L = columns, J/K = rows in a column
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }

    //── Move window ──
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }

    //── Swap / column shuffle (HL swapwindow) ──
    // H/L pull-into / push-out-of column (niri's special move). J/K shift in column.
    Mod+Ctrl+H { consume-or-expel-window-left; }
    Mod+Ctrl+L { consume-or-expel-window-right; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }

    // Tabs
    Mod+G { toggle-column-tabbed-display; }

    //── Resize ──
    Mod+R       { switch-preset-column-width; }   // cycle the preset widths
    Mod+Alt+H   { set-column-width "-10%"; }
    Mod+Alt+L   { set-column-width "+10%"; }
    Mod+Alt+K   { set-window-height "-10%"; }
    Mod+Alt+J   { set-window-height "+10%"; }

    //── Columns by index ──  Mod+N jumps to the Nth column in this workspace
    Mod+1 { focus-column 1; }
    Mod+2 { focus-column 2; }
    Mod+3 { focus-column 3; }
    Mod+4 { focus-column 4; }
    Mod+5 { focus-column 5; }
    Mod+6 { focus-column 6; }
    Mod+7 { focus-column 7; }
    Mod+8 { focus-column 8; }
    Mod+9 { focus-column 9; }

    //── Workspaces (niri stacks them vertically) ──  number keys now do columns,
    // so workspace nav lives on your unified prev/next:
    Mod+P { focus-workspace-up; }     //   unified "prev"
    Mod+N { focus-workspace-down; }   //   unified "next"

    //── Reorder column to index ──  Mod+Shift+N makes this the Nth column
    Mod+Shift+1 { move-column-to-index 1; }
    Mod+Shift+2 { move-column-to-index 2; }
    Mod+Shift+3 { move-column-to-index 3; }
    Mod+Shift+4 { move-column-to-index 4; }
    Mod+Shift+5 { move-column-to-index 5; }
    Mod+Shift+6 { move-column-to-index 6; }
    Mod+Shift+7 { move-column-to-index 7; }
    Mod+Shift+8 { move-column-to-index 8; }
    Mod+Shift+9 { move-column-to-index 9; }

    //── Move column to another workspace ──  prev/next on the letter keys
    Mod+Shift+P { move-column-to-workspace-up; }
    Mod+Shift+N { move-column-to-workspace-down; }

    //── System ──
    // logind's Lock signal, which swayidle's `lock` handler turns into
    // swaylock. Same path as idle-lock and suspend-lock, so there is one
    // locker and one look.
    Mod+Escape hotkey-overlay-title="Lock" { spawn "loginctl" "lock-session"; }

    //── Media / volume
    Mod+Shift+M { spawn "playerctl" "play-pause"; }
    Mod+Shift+BracketRight { spawn "playerctl" "next"; }
    Mod+Shift+BracketLeft  { spawn "playerctl" "previous"; }

    Mod+Shift+S { spawn "kitty" "--class" "keysound-launcher" "-e" "/home/dweller/.dotfiles/scripts/keysounds.sh" "choose"; }
    Mod+Alt+S { spawn "bash" "-c" "/home/dweller/.dotfiles/scripts/keysounds.sh toggle"; }

    //── Screenshots
    Print { 
        spawn "bash" "-c" "~/.dotfiles/scripts/screenshot.sh"
    }

    // 2. Select region -> Open in Swappy for editing
    Shift+Print { 
        spawn "sh" "-c" "grim -g \"$(slurp)\" - | swappy -f -" 
    }
}
