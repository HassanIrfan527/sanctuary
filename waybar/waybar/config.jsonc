{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": [
        "niri/workspaces",
        "custom/niri-minimap",
        "custom/niri-odometer",
        "hyprland/workspaces",
        "mpris"
    ],
    "niri/workspaces": {
        "current-only": true,
        "format": "{value}",
        "tooltip": false,
        "on-click": "niri msg action toggle-overview",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/boot",
        "custom/mic",
        "tray",
        "image#pet"
    ],
    "hyprland/workspaces": {
        "format": "{icon} {windows}",
        "format-window-separator": " ",
        "format-icons": {
            "active": "●",
            "default": "○",
            "empty": "○"
        },
        "window-format": "{icon}",
        "window-rewrite-default": "󰣆 ",
        "window-rewrite": {
            "class<kitty>": " ",
            "title<.*nvim.*>": "",
            "title<.*yazi.*>": " ",
            "class<brave-browser>": " ",
            "title<.*Zen.*>": "󰈹 ",
            "class<app.zen_browser.zen>": "󰈹 ",
            "class<org.gnome.Nautilus>": " ",
            "class<code>": "󰨞 ",
            "class<discord>": " ",
            "class<vesktop>": " ",
            "class<spotify>": "󰽴",
            "class<vlc>": "󰕼 ",
            "class<mpv>": " ",
            "class<steam>": "󰺷 ",
            "class<net.lutris.Lutris>": " ",
            "class<steam_app_.*>": " ",
            "class<thunderbird>": "󰇰 ",
            "class<com.bitwarden.desktop>": "󰌾",
            "class<com.getpostman.Postman>": "󰦔 ",
            "class<scratchterm>": " ",
            "class<beekeeper-studio>": " ",
            "class<firefox>": "󰈹 ",
            "class<librewolf>": "󰈹 ",
            "class<[Cc]hromium>": "󰊯 ",
            "class<google-chrome>": "󰊯 ",
            "class<org.qutebrowser.qutebrowser>": "󰖟 ",
            "class<obsidian>": "󱓧 ",
            "class<org.telegram.desktop>": "󰔁 ",
            "class<[Ss]ignal>": "󰭹 ",
            "class<[Ss]lack>": "󰒱 ",
            "class<[Gg]imp.*>": "󰋩 ",
            "class<imv>": "󰋩 ",
            "class<org.gnome.eog>": "󰋩 ",
            "class<org.gnome.Loupe>": "󰋩 ",
            "class<org.pwmt.zathura>": "󰈦 ",
            "class<.*[Ee]vince>": "󰈦 ",
            "class<.*[Pp]avucontrol>": "󰕾 ",
            "class<org.gnome.Calculator>": "󰃬 ",
            "class<com.obsproject.Studio>": "󰕧 ",
            "class<[Tt]hunar>": " ",
            "class<.*libreoffice.*>": "󰈙 ",
            "class<.*[Ss]office.*>": "󰈙 ",
            "class<org.gnome.Settings>": "󰒓 ",
            "class<foot>": " ",
            "class<[Aa]lacritty>": " ",
            "class<org.wezfurlong.wezterm>": " "
        },
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace m-1",
        "on-scroll-down": "hyprctl dispatch workspace m+1"
    },
    "custom/niri-minimap": {
        "exec": "/home/anonymous/.config/waybar/scripts/niri-minimap.sh",
        "tooltip": false,
        "on-click": "niri msg action toggle-overview"
    },
    "custom/niri-odometer": {
        "exec": "/home/anonymous/.config/waybar/scripts/niri-odometer.sh",
        "tooltip": false
    },
    "mpris": {
        "format": "{status_icon}  {title}",
        "format-paused": "{status_icon}  <i>{title}</i>",
        "format-stopped": "",
        "max-length": 70,
        "dynamic-len": 42,
        "status-icons": {
            "playing": "󰎈",
            "paused": "󰏤",
            "stopped": ""
        },
        "tooltip-format": "{player}: {title}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },
    "clock": {
        "format": "{:%I:%M %p · %a %d}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/boot": {
        "exec": "/home/anonymous/.config/waybar/scripts/boot.py",
        "interval": 60
    },
    "custom/mic": {
        "exec": "/home/anonymous/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && pkill -RTMIN+8 waybar",
        "on-click-right": "kitty --class=wiremix --title=wiremix -e wiremix",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+ && pkill -RTMIN+8 waybar",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%- && pkill -RTMIN+8 waybar"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "image#pet": {
        "exec": "/home/anonymous/.config/waybar/pet/pet.sh",
        "size": 20,
        "interval": 2,
        "tooltip": false,
        "on-click": "walker --provider menus:notifications",
        "on-click-right": "swaync-client -d -sw"
    }
}
