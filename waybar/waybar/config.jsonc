{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left":   ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right":  ["tray", "custom/notif"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active":  "●",
            "default": "○",
            "empty":   "○"
        },
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%H:%M · %a %d}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/notif": {
        "format": "{icon}",
        "format-icons": {
            "notification":      "󰂚",
            "none":               "󰂜",
            "dnd-notification":   "󰂛",
            "dnd-none":           "󰪑",
            "inhibited-notification": "󰂚",
            "inhibited-none":     "󰂜"
        },
        "return-type": "json",
        "exec":        "swaync-client -swb",
        "tooltip":     false,
        "on-click":       "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    }
}
