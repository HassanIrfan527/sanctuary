{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left":   ["hyprland/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right":  ["tray", "custom/notif"],

    "hyprland/workspaces": {
        "format": "{icon} {windows}",
        "format-window-separator": " ",
        "format-icons": {
            "active":  "●",
            "default": "○",
            "empty":   "○"
        },
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<kitty>":                  "",
            "title<.*nvim.*>":                "",
            "title<.*yazi.*>":                "",
            "class<brave-browser>":          "",
            "title<.*Zen.*>":                 "󰈹",
            "class<app.zen_browser.zen>":    "󰈹",
            "class<org.gnome.Nautilus>":     "",
            "class<org.qbittorrent.qBittorrent>": "",
            "class<code>":                   "󰨞",
            "class<discord>":                "",
            "class<spotify>":                "",
            "class<steam>":                  "",
            "class<steam_app_.*>":           "",
            "class<TelegramDesktop>":        "",
            "class<thunderbird>":            "",
            "class<com.bitwarden.desktop>":  "󰌾",
            "class<com.getpostman.Postman>": "󰦔",
            "class<be.alexandervanhee.gradia>": "",
            "class<bug-browse>":             "",
            "class<study-today>":            "",
            "class<scratchterm>":            ""
        },
        "on-click": "activate"
    },

    "mpris": {
        "format":        "{status_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "format-stopped": "",
        "dynamic-len": 42,
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "status-icons": {
            "playing": "󰎈",
            "paused":  "󰏤",
            "stopped": ""
        },
        "tooltip-format": "{player}: {dynamic}",
        "on-click":        "playerctl play-pause",
        "on-click-right":  "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up":    "playerctl next",
        "on-scroll-down":  "playerctl previous"
    },

    "clock": {
        "format": "{:%I:%M %p · %a %d}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/notif": {
        "format": "{icon}",
        "format-icons": {
            "notification":      "󰂚",
            "none":               "󰂜",
            "dnd-notification":   "󰂛",
            "dnd-none":           "󰪑",
            "inhibited-notification": "󰂚",
            "inhibited-none":     "󰂜"
        },
        "return-type": "json",
        "exec":        "swaync-client -swb",
        "tooltip":     false,
        "on-click":       "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    }
}
