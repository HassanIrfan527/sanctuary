{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "margin-bottom": 8,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 0,
    "name": "bottom",
    "modules-left": [
        "group/left"
    ],
    "modules-center": [],
    "modules-right": [
        "group/right"
    ],
    "group/left": {
        "orientation": "horizontal",
        "modules": [
            "custom/mode",
            "hyprland/window"
        ]
    },
    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "custom/kanji",
            "custom/keyd"
        ]
    },
    "custom/keyd": {
        "exec": "~/.config/hypr/scripts/keyd-mode-status.sh",
        "return-type": "json",
        "interval": 1,
        "signal": 9,
        "tooltip": false
    },
    "custom/mode": {
        "exec": "~/.config/hypr/scripts/mode-detector.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },
    "custom/kanji": {
        "exec": "~/.config/hypr/scripts/kanji-quote.sh",
        "return-type": "json",
        "interval": 1800
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": false,
        "rewrite": {
            "^$": "—"
        },
        "tooltip": false
    }
}
