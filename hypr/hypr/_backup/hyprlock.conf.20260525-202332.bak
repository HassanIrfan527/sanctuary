source = ~/.config/hypr/hyprlock-colors.conf

general {
    hide_cursor = true
    grace = 0
    no_fade_in = true
    no_fade_out = true
}

background {
    monitor =
    path = screenshot
    blur_passes = 2
    blur_size = 6
    noise = 0.02
    contrast = 0.9
    brightness = 0.35
    vibrancy = 0.1
}

label {
    monitor =
    text = $TIME12
    color = $text_color
    font_size = 96
    font_family = Maple Mono NF Bold

    position = 0, 140
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%a %d %b %Y"
    color = $subtext_color
    font_size = 14
    font_family = Maple Mono NF

    position = 0, 60
    halign = center
    valign = center
}

label {
    monitor =
    text = ──────────────────────────────
    color = $accent_color
    font_size = 10
    font_family = Maple Mono NF

    position = 0, 16
    halign = center
    valign = center
}

label {
    monitor =
    text =   passwd
    color = $accent_color
    font_size = 11
    font_family = Maple Mono NF Bold

    position = -140, -36
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 360, 50
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.35
    dots_center = true
    outer_color = $accent_color
    inner_color = $entry_background_color
    font_color = $text_color
    check_color = $accent_color
    fail_color = $urgent_color
    fade_on_empty = false
    placeholder_text = <span foreground="##6c7086">enter to unlock</span>
    rounding = 0
    hide_input = false

    position = 0, -50
    halign = center
    valign = center
}

label {
    monitor =
    text =   $LAYOUT  ·  $USER@$(hostname)
    color = $subtext_color
    font_size = 10
    font_family = Maple Mono NF

    position = 0, -120
    halign = center
    valign = center
}
