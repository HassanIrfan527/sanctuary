# Python
__pycache__/
*.py[cod]

# Editor/session backups — regenerated, not config
*.bak
*.gnome-backup

# Runtime theme state — rewritten by theme-switch.sh on every toggle
kitty/kitty/current-theme.conf

# Generated by qutebrowser; config.py calls load_autoconfig(False) so it is never read.
qutebrowser/qutebrowser/autoconfig.yml

# Generated per mode by scripts/sanctuary/mode.sh — it changes on every mode
# switch, so tracking it would mean a diff every time you press Mod+Shift+Z.
# install.sh seeds it (Default) on a fresh clone, where config.kdl's include
# would otherwise dangle.
niri/niri/mode.kdl
niri/niri/mode.kdl.prev
