# Python
__pycache__/
*.py[cod]

# Editor/session backups — regenerated, not config
*.bak
*.gnome-backup

# Runtime theme state — rewritten by theme-switch.sh on every toggle
kitty/kitty/current-theme.conf

# Generated by qutebrowser; config.py calls load_autoconfig(False) so it is never read.
qutebrowser/qutebrowser/autoconfig.yml

# Leftover copies of a swaync theme (the retired mode.sh wrote them; install.sh
# still seeds them so a bare `swaync` starts themed). The fallback does not read
# them — shell.sh starts swaync with -c/-s pointing at themes/ascii directly.
swaync/swaync/config.json
swaync/swaync/style.css

# Which hand-kept layout is active — a symlink shell.sh re-points on every style
# switch (layout.kdl -> layout-<style>.kdl). Tracking it would dirty the tree on
# each Mod+Shift+T. install.sh seeds it (-> layout-signal.kdl) on a fresh clone,
# where config.kdl's include would otherwise dangle.
niri/niri/layout.kdl
